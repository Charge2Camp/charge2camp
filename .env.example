# Supabase
# Local dev: run `npx supabase start` and copy the printed "API URL" / "anon key" / "service_role key".
# Cloud: copy these from your Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the browser. Used by admin/import scripts that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Charging provider adapters (Phase 4/8) — leave empty to keep providers in mock mode.
# See docs/data-sources.md for licensing status of each provider.
ECO_MOVEMENT_API_KEY=
OPEN_CHARGE_MAP_API_KEY=

# Routing engine (Phase 6) — leave empty to keep the routing adapter in mock mode.
ROUTING_PROVIDER_API_KEY=

# Wiederkehrender OCM-Reimport (vercel.json Cron -> /api/cron/ocm-import).
# Zufaelliger String, z. B. `openssl rand -hex 32` -- Vercel sendet ihn bei
# jedem Cron-Aufruf automatisch als "Authorization: Bearer <CRON_SECRET>",
# sobald diese Variable im Deploy gesetzt ist.
CRON_SECRET=

# Suchindex (Auftrag D/E) — Meilisearch, siehe docker-compose.yml.
# Lokal: `docker compose up -d meilisearch`.
MEILISEARCH_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=charge2camp-dev-master-key

# Fehler-Monitoring (Sentry, kostenlose Stufe reicht) — leer lassen, um
# Sentry lokal/ohne Account zu deaktivieren (SDK ist dann ein No-Op, siehe
# `enabled: !!NEXT_PUBLIC_SENTRY_DSN` in instrumentation-client.ts/
# sentry.server.config.ts/sentry.edge.config.ts). Projekt kostenlos anlegen
# auf sentry.io, dann Settings -> Client Keys (DSN). Die DSN ist kein
# Secret (steht im ausgelieferten Client-Bundle). SENTRY_ORG/SENTRY_PROJECT/
# SENTRY_AUTH_TOKEN werden nur für den Source-Map-Upload beim Build
# gebraucht (Vercel-Deploy) — ohne SENTRY_AUTH_TOKEN läuft der Build
# trotzdem, nur ohne lesbare Stacktraces in Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
