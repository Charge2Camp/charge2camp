# Supabase
# Local dev: run `npx supabase start` and copy the printed "API URL" / "anon key" / "service_role key".
# Cloud: copy these from your Supabase project settings -> API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the browser. Used by admin/import scripts that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Charging provider adapters (Phase 4/8) — leave empty to keep providers in mock mode.
# See docs/data-sources.md for licensing status of each provider.
ECO_MOVEMENT_API_KEY=
OPEN_CHARGE_MAP_API_KEY=

# Routing engine (Phase 6) — leave empty to keep the routing adapter in mock mode.
ROUTING_PROVIDER_API_KEY=

# Suchindex (Auftrag D/E) — Meilisearch, siehe docker-compose.yml.
# Lokal: `docker compose up -d meilisearch`.
MEILISEARCH_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=charge2camp-dev-master-key
