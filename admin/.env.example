# Gleiche Supabase-Instanz wie die Haupt-App (charge2camp) -- Werte aus
# deren .env.local uebernehmen. SUPABASE_SERVICE_ROLE_KEY ist server-only
# (kein NEXT_PUBLIC_-Praefix) und umgeht Row Level Security komplett --
# niemals ins Frontend/an den Browser durchreichen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
