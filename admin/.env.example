# Gleiche Supabase-Instanz wie die Haupt-App (charge2camp) -- Werte aus
# deren .env.local uebernehmen. SUPABASE_SERVICE_ROLE_KEY ist server-only
# (kein NEXT_PUBLIC_-Praefix) und umgeht Row Level Security komplett --
# niemals ins Frontend/an den Browser durchreichen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Fehler-Monitoring (Sentry, kostenlose Stufe reicht) — eigenes Sentry-
# Projekt empfohlen, getrennt von der Haupt-App (siehe ../.env.example für
# Details zum Verhalten ohne DSN). SENTRY_ORG/SENTRY_PROJECT/
# SENTRY_AUTH_TOKEN nur für Source-Map-Upload beim Build nötig.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# E-Mail-Benachrichtigung bei Meldestatus-Aenderung (UX-05.7, s.
# lib/providers/email/). Ohne RESEND_API_KEY faellt die App auf einen
# mock-Adapter zurueck, der nur loggt statt zu senden (CLAUDE.md Prinzip 2:
# keine Scheindaten) -- fuer lokale Entwicklung ausreichend, kein Key noetig.
# Kostenloser Resend-Tarif: 3000 Mails/Monat, keine Kreditkarte (Stand 2026).
RESEND_API_KEY=
# Absenderadresse, z.B. "charge2camp <noreply@charge2camp.de>" nach
# Domain-Verifizierung bei Resend. Ohne eigene Domain kann testweise
# "onboarding@resend.dev" genutzt werden (Resends eigene Sandbox-Domain).
NOTIFICATION_EMAIL_FROM=
