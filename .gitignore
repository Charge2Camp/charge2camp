# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase local dev
/supabase/.temp
/supabase/.branches

# vercel
.vercel

# Claude Code session-local runtime state
/.claude/scheduled_tasks.lock

# typescript
*.tsbuildinfo
next-env.d.ts

# Python-Ingest-Skripte (Datenschicht, siehe ingest/README.md)
/ingest/.venv
/ingest/.testdata
/ingest/.cache
/ingest/osm/data
/ingest/osrm/data
__pycache__/
*.pyc

.vercel
.env*

# admin/ ist eine eigenstaendige zweite Next.js-App im selben Repo
# (eigenes package.json/Deploy, siehe admin/README.md) -- braucht dieselben
# Ignores, die obigen Regeln sind auf den Repo-Root verankert (fuehrendes
# "/") und greifen dort nicht.
/admin/node_modules
/admin/.next/
/admin/out/
/admin/.vercel
/admin/.env*
!/admin/.env.example
/admin/*.tsbuildinfo
/admin/next-env.d.ts
